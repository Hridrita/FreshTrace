# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local SQLite databases (dev and test)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# generated Prisma clients
# `src/generated/prisma-sqlite` is built by `tests/global-setup.js` from
# `prisma/schema.sqlite.prisma`; `prisma/schema.sqlite.prisma` itself is
# derived from the canonical schema by `scripts/make-test-schema.mjs`.
/src/generated/
/prisma/schema.sqlite.prisma
/prisma/.prisma-client-tmp/

# next.js
/.next/
/out/
# Scratch build dir used to sidestep OneDrive file locks on `.next`.
/.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.json
*.log
*.txt
*.html

# captured screenshots (regenerated by scratch/admin-shots.mjs)
scratch/shots/

.vercel
